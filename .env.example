# Docker Compose Environment Variables
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multitenant_saas

# Backend Application Configuration
NODE_ENV=development
API_PORT=3001

# Database Connection (for Docker Compose - uses service names)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multitenant_saas

# Redis Connection (for Docker Compose - uses service names)
REDIS_URL=redis://redis:6379

# JWT Configuration
# IMPORTANT: Change these in production! Use strong, random secrets (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Encryption Key (32 characters minimum)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Default Client Configuration (for localhost development)
DEFAULT_CLIENT_ID=
DEFAULT_CLIENT_SUBDOMAIN=admin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Global rate limit (all API requests per minute). Default 50000
# GLOBAL_RATE_LIMIT_MAX_REQUESTS=50000

# DMN Pipeline (AI service for document → DMN)
# Development (Docker): backend in container, DMN on host
#   DMN_PIPELINE_API_URL=http://host.docker.internal:8000/api/v1
# Development (local): DMN on same machine
#   DMN_PIPELINE_API_URL=http://localhost:8000/api/v1
# Production: set to your DMN API base URL (e.g. https://dmn.yourdomain.com/api/v1 or http://dmn-pipeline:8000/api/v1)
DMN_PIPELINE_API_URL=http://host.docker.internal:8000/api/v1
# Optional: timeout for /api/dmn requests (ms). Default 180000 (3 min)
# DMN_REQUEST_TIMEOUT_MS=180000
# Optional: timeout for the pipeline/run HTTP call to the AI service (ms). Default 300000 (5 min)
# DMN_PIPELINE_RUN_TIMEOUT_MS=300000
# Optional: timeout for other DMN API calls (progress, result, etc.). Default 30000
# DMN_PIPELINE_TIMEOUT_MS=30000

# PII Scan (optional - for workflow file upload)
# PII_SCAN_API_URL=http://localhost:8000/api/v1/security/pii-scan/bytes

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
