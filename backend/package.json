{
  "name": "backend",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate",
    "migration:run": "tsx src/scripts/runMigrations.ts",
    "migration:run:prod": "node dist/scripts/runMigrations.js",
    "migration:run:all": "tsx src/scripts/runMigrationsOnAllTenants.ts",
    "migration:run:all:prod": "node dist/scripts/runMigrationsOnAllTenants.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/database.ts",
    "tenant:create-db": "tsx src/scripts/createTenantWithDatabase.ts",
    "tenant:create-db:prod": "node dist/scripts/createTenantWithDatabase.js",
    "tenant:create-user": "tsx src/scripts/createTenantUser.ts",
    "tenant:create-user:prod": "node dist/scripts/createTenantUser.js",
    "tenant:seed": "tsx src/scripts/seedTenantData.ts",
    "tenant:seed:prod": "node dist/scripts/seedTenantData.js",
    "tenant:delete-schema": "tsx src/scripts/deleteSchemaTenants.ts",
    "tenant:delete-schema:prod": "node dist/scripts/deleteSchemaTenants.js",
    "tenant:drop-schemas": "tsx src/scripts/dropTenantSchemas.ts",
    "tenant:drop-schemas:prod": "node dist/scripts/dropTenantSchemas.js",
    "tenant:remove-system-tables": "tsx src/scripts/removeSystemTablesFromTenants.ts",
    "tenant:remove-system-tables:prod": "node dist/scripts/removeSystemTablesFromTenants.js",
    "tenant:fix-fks": "tsx src/scripts/fixTenantDatabaseFKs.ts",
    "tenant:fix-fks:prod": "node dist/scripts/fixTenantDatabaseFKs.js",
    "seed": "tsx src/seeds/index.ts",
    "seed:prod": "node dist/seeds/index.js",
    "seed:emails-redis": "tsx src/scripts/seedEmailsToRedis.ts",
    "seed:emails-redis:prod": "node dist/scripts/seedEmailsToRedis.js",
    "encrypt:all": "tsx src/scripts/encryptAllSensitiveConfigs.ts",
    "encrypt:sso": "tsx src/scripts/encryptAllSensitiveConfigs.ts --sso-only",
    "encrypt:storage": "tsx src/scripts/encryptAllSensitiveConfigs.ts --storage-only",
    "encrypt:dry-run": "tsx src/scripts/encryptAllSensitiveConfigs.ts --dry-run",
    "encrypt:all:prod": "node dist/scripts/encryptAllSensitiveConfigs.js",
    "encrypt:sso:prod": "node dist/scripts/encryptAllSensitiveConfigs.js --sso-only",
    "encrypt:storage:prod": "node dist/scripts/encryptAllSensitiveConfigs.js --storage-only",
    "encrypt:dry-run:prod": "node dist/scripts/encryptAllSensitiveConfigs.js --dry-run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest src/__tests__/api",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.933.0",
    "@aws-sdk/client-secrets-manager": "^3.940.0",
    "@azure/storage-blob": "^12.29.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "openid-client": "^6.8.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.0",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17",
    "uuid": "^13.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
